; ============================================================
; 7explorer - theme configuration example
; Copy this file to "config.ini" next to explorer.exe
; (e.g. C:\Win7ExplorerRestorerTest\config.ini).
;
; 7explorer NEVER modifies system files (uxtheme.dll,
; themeui.dll, Windows themes, etc.): everything happens in
; its own directory/process.
; ============================================================

[Theme]
; Mode can be:
;   Auto      (default) use <exedir>\theme\<Name>.msstyles if the file
;             exists (as in previous tests); otherwise use the
;             Win7-like theme embedded in wrp64.dll (automatically
;             extracted to %LocalAppData%\7explorer\theme\aero.msstyles)
;   Fallback  always use the embedded theme (ignore external files)
;   Custom    always try <exedir>\theme\<Name>.msstyles; if it fails,
;             fall back to the embedded theme
;   Windows7  alias for Custom (to provide a Windows 7 aero.msstyles)
;   Windows81 alias for Custom (to provide a Windows 8.1 aero.msstyles)
;
; In ALL cases, if the selected theme fails to load, 7explorer
; falls back to the embedded theme, and if that also fails, uses
; the classic look: startup is never blocked.
Mode=Auto

; Name of the msstyles file (without the extension) under <exedir>\theme\
; Examples: aero, aero7, aerolite, ...
; If omitted, the registry "Theme" value is used; default is "aero".
Name=aero
